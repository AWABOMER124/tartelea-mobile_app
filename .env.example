# Production endpoints (required for release testing)
API_BASE_URL=https://api.tartelea.com/api/v1
LIVEKIT_API_BASE_URL=wss://rtc.tartelea.com

# Optional
GOOGLE_SERVER_CLIENT_ID=
SUBSCRIPTIONS_PAUSED=false
